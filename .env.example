# Gemma 2 Inference Provider (Defaults to local Ollama)
# Options: "ollama" (local, 100% private) | "openrouter" | "groq" | "vllm"
GEMMA_PROVIDER=ollama
GEMMA_MODEL=gemma2:9b
OLLAMA_BASE_URL=http://localhost:11434

# If using remote Gemma 2 inference (optional fallback)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# MongoDB Atlas (for safe-clause vector database & history)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/clauseguard?retryWrites=true&w=majority

# ElevenLabs (for 45-second audio risk briefings)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Sentry (for Agent Tracing & error monitoring)
SENTRY_DSN=
